# ============================================================================
# Trading Grid AI System - Environment Configuration
# ============================================================================
# Copy this file to .env and configure with your values
# NEVER commit .env to git!
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
APP_ENV=development

# SECURITY: APP_DEBUG defaults to false. It only controls /docs, /redoc and
# permissive CORS. It NEVER bypasses authentication.
# Must be false in production (the app refuses to start otherwise).
APP_DEBUG=false

# SECURITY: APP_DEV_AUTH_ENABLED defaults to false.
# When true (ONLY allowed with APP_ENV=development), unauthenticated API
# requests are granted a DEMO-only identity. It can NEVER access LIVE trading.
# Leave this false unless you are doing local development without auth.
APP_DEV_AUTH_ENABLED=false

# SECURITY: APP_SECRET_KEY MUST be set in production. The default dev secret
# is unsafe for production (JWTs could be forged by anyone with the source).
# Minimum length: 32 characters.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave the dev default below for local development only.
APP_SECRET_KEY=dev-jwt-secret-key-change-in-production
APP_NAME=Trading Grid AI System
APP_VERSION=0.1.0

# ----------------------------------------------------------------------------
# DATABASE (Phase 1: Supabase cloud)
# ----------------------------------------------------------------------------
# Get connection string from: Supabase Dashboard → Settings → Database
# Supabase gives you: postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres
# IMPORTANT: Change "postgresql://" to "postgresql+asyncpg://" for SQLAlchemy async
# Example:
#   Supabase gives:  postgresql://postgres:mypass@db.abc123.supabase.co:5432/postgres
#   Change to:       postgresql+asyncpg://postgres:mypass@db.abc123.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.xxxxx.supabase.co:5432/postgres

# Database (Phase 2: Local PostgreSQL di Proxmox LXC)
# Uncomment when migrating from Supabase to local PostgreSQL.
# See docs/DEPLOYMENT_PROXMOX.md Section 9.
# DATABASE_URL=postgresql+asyncpg://trading_grid_user:your-password@localhost:5432/trading_grid

# Database echo SQL (for debugging, set to false in production)
DATABASE_ECHO=false

# ----------------------------------------------------------------------------
# REDIS (Phase 3+ only, not needed for Phase 0-2)
# ----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# OKX API (Demo Trading)
# ----------------------------------------------------------------------------
# Get API keys from: OKX → Trade → Demo Trading → API
# IMPORTANT: 
#   - Enable ONLY "Read" and "Trade" permissions
#   - DISABLE "Withdraw" permission
#   - Use separate keys for Demo and Live
OKX_API_KEY=your-demo-api-key
OKX_API_SECRET=your-demo-api-secret
OKX_PASSPHRASE=your-demo-passphrase

# Demo mode (true = use OKX Demo Trading, false = Live Trading)
# ALWAYS start with true!
OKX_DEMO_MODE=true

# OKX API base URLs (do not change unless OKX changes them)
# REST: same URL for Demo & Live — the difference is the "x-simulated-trading: 1" header
OKX_BASE_URL=https://www.okx.com
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5

# Demo Trading URLs (for reference, automatically used when OKX_DEMO_MODE=true)
# REST:        https://openapi.okx.com + header "x-simulated-trading: 1"
# Public WS:   wss://wspap.okx.com:8443/ws/v5/public
# Private WS:  wss://wspap.okx.com:8443/ws/v5/private
# Business WS: wss://wspap.okx.com:8443/ws/v5/business

# ----------------------------------------------------------------------------
# OKX API (Live Trading) - Phase 5 only
# ----------------------------------------------------------------------------
# WARNING: Only configure when ready for live trading
# LIVE_OKX_API_KEY=your-live-api-key
# LIVE_OKX_API_SECRET=your-live-api-secret
# LIVE_OKX_PASSPHRASE=your-live-passphrase

# ----------------------------------------------------------------------------
# BINANCE API (Spot Trading)
# ----------------------------------------------------------------------------
# Get API keys from: Binance → Account → API Management
# IMPORTANT:
#   - Enable ONLY "Read" and "Spot & Margin Trading" permissions
#   - DISABLE "Withdrawals" permission
#   - Use separate keys for Testnet and Live
#   - Testnet: https://testnet.binance.vision/
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret

# Testnet mode (true = use Binance Testnet, false = Live Trading)
# ALWAYS start with true!
BINANCE_TESTNET_MODE=true

# Binance API base URLs (do not change unless Binance changes them)
# Live:    https://api.binance.com
# Testnet: https://testnet.binance.vision
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# recvWindow for signed requests (milliseconds)
# Increase this if you experience timestamp/recvWindow errors due to
# high network latency (e.g., VPS in a different region).
# Default: 5000 (Binance spec minimum is 5000)
BINANCE_RECV_WINDOW_MS=5000

# ----------------------------------------------------------------------------
# BYBIT API (Spot Trading)
# ----------------------------------------------------------------------------
# Get API keys from: Bybit → Account → API
# IMPORTANT:
#   - Enable ONLY "Read" and "Trade" permissions (Spot)
#   - DISABLE "Withdraw" permission
#   - Use separate keys for Testnet and Live
#   - Testnet: https://testnet.bybit.com/
BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret

# Testnet mode (true = use Bybit Testnet, false = Live Trading)
# ALWAYS start with true!
BYBIT_TESTNET_MODE=true

# Bybit API base URLs (do not change unless Bybit changes them)
# Live:    https://api.bybit.com
# Testnet: https://api-testnet.bybit.com
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public

# ----------------------------------------------------------------------------
# TELEGRAM BOT
# ----------------------------------------------------------------------------
# Get token from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Allowed Telegram user IDs (comma-separated)
# Get your user ID from: @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_IDS=123456789

# Admin Telegram user ID (for approval workflows)
TELEGRAM_ADMIN_USER_ID=123456789

# Open access mode (true = anyone can use the bot, for beta trial only)
# WARNING: Set to false for production!
TELEGRAM_OPEN_ACCESS=false

# ----------------------------------------------------------------------------
# RISK LIMITS (Development defaults)
# ----------------------------------------------------------------------------
# Maximum capital per grid (USDT)
RISK_MAX_CAPITAL_PER_GRID=100

# Maximum total capital across all grids (USDT)
RISK_MAX_TOTAL_CAPITAL=500

# Maximum drawdown before emergency stop (percentage)
RISK_MAX_DRAWDOWN_PCT=10

# Maximum number of concurrent grids
RISK_MAX_CONCURRENT_GRIDS=5

# ----------------------------------------------------------------------------
# RESEARCH / ML
# ----------------------------------------------------------------------------
# Data directory for Parquet files
RESEARCH_DATA_DIR=data/research

# Model registry directory
RESEARCH_MODELS_DIR=models

# Parquet compression: snappy, gzip, zstd
RESEARCH_PARQUET_COMPRESSION=snappy

# Candle interval for research: 1m, 5m, 15m, 1H, 4H, 1D
RESEARCH_CANDLE_INTERVAL=1H

# Lookback period for historical data (days, default 3 years)
RESEARCH_LOOKBACK_DAYS=1095

# Minimum candles required for valid market data
RESEARCH_MIN_CANDLES=1000

# Number of CPU cores for parallel processing (-1 = all cores)
RESEARCH_N_JOBS=-1

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or console
LOG_FORMAT=console

# Log file (optional, leave empty for stdout only)
LOG_FILE=

# ----------------------------------------------------------------------------
# SCHEDULING
# ----------------------------------------------------------------------------
# Enable APScheduler (for periodic jobs)
SCHEDULER_ENABLED=true

# Research retraining interval (hours)
RETRAIN_INTERVAL_HOURS=168

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# API key for Application Control API
API_KEY=change-me-to-a-random-api-key

# JWT secret (for token-based auth)
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ----------------------------------------------------------------------------
# CREDENTIAL ENCRYPTION (Phase 5: Multi-Tenant Beta)
# ----------------------------------------------------------------------------
# Fernet key for encrypting user exchange API credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If you lose this key, all stored user credentials become unrecoverable.
# Back up this key securely (e.g., password manager / secrets vault).
CREDENTIAL_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# MONITORING (Phase 3+)
# ----------------------------------------------------------------------------
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090